# Onshape API credentials — create a key pair at https://dev-portal.onshape.com/keys
# The account owning the key must have access to the document referenced in config.json.
#
# Copy this file to .env (gitignored) and fill in your own values:
#   cp .env.example .env
#
# onshape-to-robot loads .env automatically (python-dotenv) when run from the repo root.

# Onshape instance / base URL
ONSHAPE_API=https://cad.onshape.com

# API key pair from the dev portal
ONSHAPE_ACCESS_KEY=your_access_key_here
ONSHAPE_SECRET_KEY=your_secret_key_here

# Alternative to the key pair above: a service-account bearer secret
# (set ONSHAPE_SECRET_BEARER instead of ACCESS_KEY/SECRET_KEY)
# ONSHAPE_SECRET_BEARER=your_bearer_secret_here
